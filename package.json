{
  "name": "release-receipt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Сверяет коммит, результат CI и фактически развёрнутую версию сайта и выдаёт JSON-квитанцию",
  "engines": { "node": ">=24" },
  "bin": { "release-receipt": "dist/release-receipt.mjs" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "build:cli": "node scripts/build.mjs --cli",
    "e2e": "playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
